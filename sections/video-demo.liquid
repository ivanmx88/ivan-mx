<div class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page">
    <div class="section__header section__header--center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="text-muted stack">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="demo">
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag:
            autoplay: false,
            loop: true,
            muted: true,
            controls: true,
            playsinline: true,
            preload: 'none',
            image_size: '1200x'
        }}
      {%- else -%}
        <div class="media-placeholder">
          <strong>Hueco para el vídeo demo</strong>
          <span>Sube aquí el vídeo del plato sucio quedando limpio. Con controles y sin autoplay, para no penalizar la carga.</span>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <p class="text-center" style="margin-top: 1.5rem;">
        <a class="button" href="{{ section.settings.button_link | default: '#comprar' }}">
          {{ section.settings.button_label }}
        </a>
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Vídeo demo",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Míralo en acción" },
    { "type": "text", "id": "subheading", "label": "Subtítulo" },
    {
      "type": "video",
      "id": "video",
      "label": "Vídeo demo",
      "info": "Del plato sucio al plato limpio. Comprímelo antes de subirlo."
    },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Comprar ahora" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "checkbox", "id": "surface", "label": "Fondo secundario", "default": true }
  ],
  "presets": [{ "name": "Vídeo demo" }]
}
{% endschema %}
