<div class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page">
    <div class="section__header section__header--center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="benefits">
      {%- for block in section.blocks -%}
        <div class="benefit" {{ block.shopify_attributes }}>
          {% render 'icon', name: block.settings.icon %}
          <h3 class="benefit__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="benefit__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Beneficios",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Por qué gusta tanto" },
    { "type": "checkbox", "id": "surface", "label": "Fondo secundario", "default": false }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Beneficio",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "sparkle", "label": "Todo en uno" },
            { "value": "drop", "label": "Dosis de jabón" },
            { "value": "hand", "label": "Manos" },
            { "value": "box", "label": "Recogido" },
            { "value": "leaf", "label": "Materiales" },
            { "value": "truck", "label": "Envío" }
          ],
          "default": "sparkle"
        },
        { "type": "text", "id": "title", "label": "Título", "default": "Beneficio" },
        { "type": "text", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Beneficios",
      "blocks": [
        { "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }, { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
