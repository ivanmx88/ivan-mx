<div class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page">
    <div class="section__header section__header--center">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="text-muted stack">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="promise">
      <div class="promise__card">
        <span class="promise__label">{{ section.settings.problem_label }}</span>
        <h3>{{ section.settings.problem_heading }}</h3>
        <ul class="promise__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'problem' -%}
              <li {{ block.shopify_attributes }}>
                <span style="color: var(--color-text-muted);">{% render 'icon', name: 'cross' %}</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>

      <div class="promise__card promise__card--solution">
        <span class="promise__label">{{ section.settings.solution_label }}</span>
        <h3>{{ section.settings.solution_heading }}</h3>
        <ul class="promise__list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'solution' -%}
              <li {{ block.shopify_attributes }}>
                <span style="color: var(--color-accent);">{% render 'icon', name: 'check' %}</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Problema y promesa",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Fregar no debería ser tan pesado" },
    { "type": "text", "id": "subheading", "label": "Subtítulo" },
    { "type": "checkbox", "id": "surface", "label": "Fondo secundario", "default": false },
    { "type": "text", "id": "problem_label", "label": "Etiqueta del problema", "default": "Antes" },
    { "type": "text", "id": "problem_heading", "label": "Título del problema", "default": "Con el bote de jabón" },
    { "type": "text", "id": "solution_label", "label": "Etiqueta de la solución", "default": "Con Aurea" },
    { "type": "text", "id": "solution_heading", "label": "Título de la solución", "default": "Todo en uno" }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problema",
      "settings": [{ "type": "text", "id": "text", "label": "Texto", "default": "Punto del problema" }]
    },
    {
      "type": "solution",
      "name": "Solución",
      "settings": [{ "type": "text", "id": "text", "label": "Texto", "default": "Punto de la solución" }]
    }
  ],
  "presets": [{ "name": "Problema y promesa" }]
}
{% endschema %}
