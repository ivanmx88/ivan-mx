{%- liquid
  assign p = section.settings.product
  assign wanted = section.settings.pack_option | downcase
  assign pack_index = -1

  for option in p.options_with_values
    assign this_name = option.name | downcase
    if this_name == wanted
      assign pack_index = forloop.index0
    endif
  endfor
-%}

<div class="section{% if section.settings.surface %} section--surface{% endif %}" id="comprar">
  <div class="page">
    <div class="section__header section__header--center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="text-muted stack">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="packs">
      {%- for block in section.blocks -%}
        {%- liquid
          assign pack_value = block.settings.option_value
          assign pack_price = 0
          assign pack_compare = 0
          assign matches = 0

          for variant in p.variants
            if pack_index >= 0 and variant.options[pack_index] == pack_value
              assign matches = matches | plus: 1
              if matches == 1
                assign pack_price = variant.price
                assign pack_compare = variant.compare_at_price
              endif
            endif
          endfor
        -%}

        <div class="pack{% if block.settings.featured %} pack--featured{% endif %}" {{ block.shopify_attributes }}>
          {%- if block.settings.badge != blank -%}
            <span class="pack__badge">{{ block.settings.badge }}</span>
          {%- endif -%}

          <h3 class="pack__title">{{ block.settings.title }}</h3>

          {%- if matches > 0 -%}
            <div class="pack__price">
              <span>{{ pack_price | money }}</span>
              {%- if pack_compare > pack_price -%}
                <s>{{ pack_compare | money }}</s>
              {%- endif -%}
            </div>

            {%- if block.settings.units > 1 -%}
              {%- assign unit_price = pack_price | divided_by: block.settings.units -%}
              <p class="pack__unit">{{ unit_price | money }} por unidad</p>
            {%- endif -%}
          {%- else -%}
            <div class="pack__pending">
              Sin variante enlazada. Crea la opción «{{ section.settings.pack_option }}» con el valor
              «{{ pack_value }}» en el producto.
            </div>
          {%- endif -%}

          {%- if block.settings.features != blank -%}
            <ul class="pack__list">
              {%- assign lines = block.settings.features | newline_to_br | split: '<br />' -%}
              {%- for line in lines -%}
                {%- assign clean = line | strip -%}
                {%- if clean != blank -%}
                  <li>{% render 'icon', name: 'check' %}<span>{{ clean }}</span></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}

          {%- if matches > 0 -%}
            {%- form block.id -%}
              {%- if matches > 1 -%}
                <label class="field__label" for="PackVariant-{{ block.id }}">Color</label>
                <select class="field__input" id="PackVariant-{{ block.id }}" name="id" style="margin-bottom: 0.75rem;">
                  {%- for variant in p.variants -%}
                    {%- if variant.options[pack_index] == pack_value -%}
                      {%- assign label = variant.title | replace: pack_value, '' | replace: ' / ', '' | strip -%}
                      <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                        {{ label | default: variant.title }}{% unless variant.available %} — agotado{% endunless %}
                      </option>
                    {%- endif -%}
                  {%- endfor -%}
                </select>
              {%- else -%}
                {%- for variant in p.variants -%}
                  {%- if variant.options[pack_index] == pack_value -%}
                    <input type="hidden" name="id" value="{{ variant.id }}">
                    {%- break -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}

              <button class="button button--full" type="submit" name="add">
                {{ section.settings.button_label }}
              </button>
            {%- endform -%}
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.note != blank -%}
      <p class="text-center text-sm text-muted" style="margin-top: 1.5rem;">{{ section.settings.note }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Packs",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto" },
    {
      "type": "text",
      "id": "pack_option",
      "label": "Nombre de la opción de pack",
      "info": "Tal cual está escrita en el producto de Shopify.",
      "default": "Pack"
    },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Elige tu pack" },
    { "type": "text", "id": "subheading", "label": "Subtítulo" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Comprar ahora" },
    { "type": "text", "id": "note", "label": "Nota bajo los packs" },
    { "type": "checkbox", "id": "surface", "label": "Fondo secundario", "default": false }
  ],
  "blocks": [
    {
      "type": "pack",
      "name": "Pack",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "1 unidad" },
        {
          "type": "text",
          "id": "option_value",
          "label": "Valor de la opción en Shopify",
          "info": "Debe coincidir exactamente con el valor de la variante.",
          "default": "1 unidad"
        },
        { "type": "number", "id": "units", "label": "Unidades que incluye", "default": 1 },
        { "type": "text", "id": "badge", "label": "Etiqueta destacada" },
        { "type": "checkbox", "id": "featured", "label": "Resaltar este pack", "default": false },
        { "type": "textarea", "id": "features", "label": "Puntos incluidos", "info": "Uno por línea." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Packs",
      "blocks": [{ "type": "pack" }, { "type": "pack" }, { "type": "pack" }]
    }
  ]
}
{% endschema %}
