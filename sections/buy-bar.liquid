{%- comment -%}
  Barra de compra fija en móvil. Aparece al pasar el hero.
{%- endcomment -%}

{%- liquid
  assign bp = section.settings.product
  assign bv = bp.selected_or_first_available_variant
-%}

{%- if bp != blank -%}
  <div class="buybar" data-buybar>
    <div class="buybar__info">
      <span class="buybar__name">{{ section.settings.label | default: bp.title }}</span>
      <span class="buybar__price">{{ bv.price | money }}</span>
    </div>
    <a class="button" href="{{ section.settings.button_link | default: '#comprar' }}">
      {{ section.settings.button_label }}
    </a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de compra fija",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto" },
    { "type": "text", "id": "label", "label": "Texto pequeño", "info": "Si lo dejas vacío se usa el nombre del producto." },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Comprar ahora" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón", "info": "Vacío lleva a la sección de packs." }
  ],
  "presets": [{ "name": "Barra de compra fija" }]
}
{% endschema %}
