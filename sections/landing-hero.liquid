{%- liquid
  assign lp = section.settings.product
  assign lv = lp.selected_or_first_available_variant
-%}

<section class="lhero">
  <div class="lhero__inner">
    <div class="lhero__media">
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true,
            preload: 'metadata',
            image_size: '900x'
        }}
      {%- elsif section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1000, format: 'webp' }}"
          srcset="
            {{ section.settings.image | image_url: width: 500, format: 'webp' }} 500w,
            {{ section.settings.image | image_url: width: 1000, format: 'webp' }} 1000w
          "
          sizes="(min-width: 900px) 50vw, 100vw"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <div class="media-placeholder">
          <strong>Hueco para el vídeo del hero</strong>
          <span>Sube aquí un vídeo vertical (9:16) del producto en uso. Se reproduce solo, en bucle y sin sonido.</span>
        </div>
      {%- endif -%}
    </div>

    <div class="lhero__content">
      <h1 class="lhero__heading">{{ section.settings.heading }}</h1>

      {%- if section.settings.subheading != blank -%}
        <p class="lhero__lede">{{ section.settings.subheading }}</p>
      {%- endif -%}

      <div class="lhero__buy">
        <a class="button" href="{{ section.settings.button_link | default: '#comprar' }}">
          {{ section.settings.button_label }}
        </a>
        {%- if lp != blank -%}
          <span class="lhero__price">{{ lv.price | money }}</span>
        {%- endif -%}
      </div>

      <ul class="microtrust">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {% render 'icon', name: block.settings.icon %}
            <span>{{ block.settings.text }}</span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero landing",
  "settings": [
    { "type": "product", "id": "product", "label": "Producto", "info": "De aquí se saca el precio." },
    {
      "type": "video",
      "id": "video",
      "label": "Vídeo (autoplay, en bucle, sin sonido)",
      "info": "Vertical 9:16. Comprímelo antes de subirlo: por debajo de 5 MB carga rápido en móvil."
    },
    { "type": "image_picker", "id": "image", "label": "Imagen de reserva", "info": "Se usa si no hay vídeo." },
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Friega sin volver a tocar el bote de jabón"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "default": "Un cepillo con el jabón dentro. Aprietas el botón, sale la dosis justa por las escobillas y friegas."
    },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Comprar ahora" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón", "info": "Déjalo vacío para llevar a la sección de packs." }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Microconfianza",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "options": [
            { "value": "truck", "label": "Envío" },
            { "value": "return", "label": "Devoluciones" },
            { "value": "lock", "label": "Pago seguro" },
            { "value": "chat", "label": "Atención" }
          ],
          "default": "truck"
        },
        { "type": "text", "id": "text", "label": "Texto", "default": "Envío 5-12 días laborables" }
      ]
    }
  ],
  "presets": [{ "name": "Hero landing" }]
}
{% endschema %}
