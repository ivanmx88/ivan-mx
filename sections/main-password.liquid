<div class="page page--narrow">
  <h1>{{ shop.name }}</h1>

  {%- if shop.password_message != blank -%}
    <div class="rte stack">{{ shop.password_message }}</div>
  {%- endif -%}

  {%- form 'storefront_password' -%}
    <div class="newsletter__form" style="justify-content: center;">
      <label class="visually-hidden" for="Password">{{ 'general.password_page.password_label' | t }}</label>
      <input class="field__input" id="Password" type="password" name="password" autocomplete="current-password">
      <button class="button" type="submit">{{ 'general.password_page.submit' | t }}</button>
    </div>

    {%- if form.errors -%}
      <p class="stack text-sm" style="color: var(--color-sale);">{{ form.errors | default_errors }}</p>
    {%- endif -%}
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contraseña",
  "settings": []
}
{% endschema %}
