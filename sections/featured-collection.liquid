<div class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page">
    <div class="section__header{% if section.settings.center %} section__header--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="text-muted stack">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    {%- assign collection = collections[section.settings.collection] -%}

    {%- if collection.products.size > 0 -%}
      <div class="product-grid{% if section.settings.columns == 4 %} product-grid--4{% endif %}">
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          {% render 'product-card', card_product: product %}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all and collection.all_products_count > section.settings.products_to_show -%}
        <p class="text-center" style="margin-top: 2rem;">
          <a class="button button--secondary" href="{{ collection.url }}">
            {{ 'collections.general.view_all' | t | default: 'Ver todo' }}
          </a>
        </p>
      {%- endif -%}
    {%- else -%}
      <p class="text-muted text-center">{{ 'collections.general.no_products' | t }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Colección destacada",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Colección"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Los más vendidos"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Productos a mostrar",
      "default": 4
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columnas en escritorio",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "center",
      "label": "Centrar el título",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "surface",
      "label": "Fondo secundario",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Mostrar botón «Ver todo»",
      "default": true
    }
  ],
  "presets": [{ "name": "Colección destacada" }]
}
{% endschema %}
