<div class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page">
    <div class="section__header section__header--center">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="text-muted stack">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </div>

    <div class="steps">
      {%- for block in section.blocks -%}
        <div class="step" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <div class="step__media media">
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 400 }} 400w,
                  {{ block.settings.image | image_url: width: 800 }} 800w
                "
                sizes="(min-width: 750px) 33vw, 100vw"
                alt="{{ block.settings.image.alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            </div>
          {%- endif -%}

          <span class="step__number" aria-hidden="true">{{ forloop.index }}</span>
          <h3 class="step__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="step__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cómo funciona",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Cómo funciona" },
    { "type": "text", "id": "subheading", "label": "Subtítulo" },
    { "type": "checkbox", "id": "surface", "label": "Fondo secundario", "default": true }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Paso",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "title", "label": "Título", "default": "Título del paso" },
        { "type": "text", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Cómo funciona",
      "blocks": [{ "type": "step" }, { "type": "step" }, { "type": "step" }]
    }
  ]
}
{% endschema %}
