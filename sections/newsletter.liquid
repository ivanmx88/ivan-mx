<div class="section{% if section.settings.surface %} section--surface{% endif %}">
  <div class="page page--narrow text-center">
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}
      <p class="text-muted stack">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- form 'customer', class: 'newsletter' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">

      {%- if form.posted_successfully? -%}
        <p class="stack">{{ 'general.newsletter.success' | t }}</p>
      {%- else -%}
        <div class="newsletter__form">
          <label class="visually-hidden" for="NewsletterEmail">{{ 'newsletter.label' | t }}</label>
          <input
            class="field__input"
            id="NewsletterEmail"
            type="email"
            name="contact[email]"
            placeholder="{{ 'newsletter.label' | t }}"
            autocomplete="email"
            required
          >
          <button class="button" type="submit">{{ 'newsletter.submit' | t }}</button>
        </div>
      {%- endif -%}

      {%- if form.errors -%}
        <p class="stack text-sm" style="color: var(--color-sale);">{{ form.errors | default_errors }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Novedades y consejos" },
    { "type": "text", "id": "text", "label": "Texto" },
    { "type": "checkbox", "id": "surface", "label": "Fondo secundario", "default": true }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
