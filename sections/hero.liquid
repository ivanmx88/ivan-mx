<div class="hero">
  <div class="hero__media media">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="
          {{ section.settings.image | image_url: width: 800 }} 800w,
          {{ section.settings.image | image_url: width: 1400 }} 1400w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w
        "
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="hero__content{% if section.settings.text_dark %} hero__content--dark{% endif %}">
    <div class="page">
      <div class="hero__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        <h2 class="h1">{{ section.settings.heading }}</h2>

        {%- if section.settings.subheading != blank -%}
          <p class="stack">{{ section.settings.subheading }}</p>
        {%- endif -%}

        <div class="hero__actions">
          {%- if section.settings.button_label != blank -%}
            <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.button_label_2 != blank -%}
            <a class="button button--secondary" href="{{ section.settings.button_link_2 }}">{{ section.settings.button_label_2 }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Lo que usas cada día, bien hecho"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "info": "Una frase. Di qué problema resuelve, no lo bonito que es."
    },
    {
      "type": "checkbox",
      "id": "text_dark",
      "label": "Texto oscuro sin degradado",
      "info": "Actívalo solo si la imagen es clara y el texto se lee bien.",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón principal",
      "default": "Ver productos"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón principal"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Botón secundario"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Enlace del botón secundario"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
