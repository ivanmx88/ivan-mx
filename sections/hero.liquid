<section class="hero">
  <div class="hero__inner{% if section.settings.image_position == 'right' %} hero--image-right{% endif %}">
    <div class="hero__media media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          srcset="
            {{ section.settings.image | image_url: width: 600 }} 600w,
            {{ section.settings.image | image_url: width: 900 }} 900w,
            {{ section.settings.image | image_url: width: 1200 }} 1200w
          "
          sizes="(min-width: 750px) 50vw, 100vw"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    <div class="hero__content">
      <div class="hero__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        <h2 class="h1">{{ section.settings.heading }}</h2>

        {%- if section.settings.subheading != blank -%}
          <p class="hero__lede">{{ section.settings.subheading }}</p>
        {%- endif -%}

        <div class="hero__actions">
          {%- if section.settings.button_label != blank -%}
            <a class="button" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
          {%- endif -%}
          {%- if section.settings.meta != blank -%}
            <span class="hero__meta">{{ section.settings.meta }}</span>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen",
      "info": "Funciona mejor con fotos verticales. Se muestra completa, sin recortes agresivos."
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Posición de la imagen en escritorio",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "right", "label": "Derecha" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Antetítulo"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "El jabón, dentro del cepillo"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subtítulo",
      "info": "Una frase. Di qué problema resuelve, no lo bonito que es."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Botón",
      "default": "Ver el producto"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "text",
      "id": "meta",
      "label": "Texto junto al botón",
      "info": "Para el precio o el plazo de envío. Solo datos ciertos."
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
