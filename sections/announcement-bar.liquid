{%- if section.settings.text != blank -%}
  <div class="announcement">
    <div class="page">
      <p>
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
        {%- else -%}
          {{ section.settings.text }}
        {%- endif -%}
      </p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Barra de anuncio",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Texto",
      "info": "Usa un mensaje real y verificable (envío, plazos, garantía). No inventes urgencia."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
